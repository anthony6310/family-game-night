# Copy to apps/web/.env and apps/server/.env (never commit the real files).

# --- apps/web (exposed to the browser: only public values here!) ---
# Leave VITE_SERVER_URL unset for local work: the web app finds the server on the same machine that served the page,
# so phones on your Wi-Fi work with no setup. Only set it when the server is on a DIFFERENT host (a deployment).
# VITE_SERVER_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- apps/server (private: the secret key bypasses RLS) ---
PORT=3001
# DEPLOY: for a real deployment set this to your site, and review the deploy checklist in apps/server/src/server.ts.
# Optional: extra website origins allowed to use the server, comma separated (e.g. your deployed site).
# localhost and local-network addresses (192.168.x.x, 10.x.x.x, ...) are always allowed.
# CLIENT_ORIGIN=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Used in MVP 2 to verify user JWTs on the socket handshake.
SUPABASE_JWKS_URL=

# Optional, dev only: shorten the timers to test faster (milliseconds). Leave unset for the real game.
# COUNTDOWN_MS=1000
# ROUND_MS=3000        # Tap Race round
# SNOWBALL_MS=10000    # Snowball round
# FINISH_MS=1000        # the "you won / you lost" sequence
# RESULTS_MS=1500
