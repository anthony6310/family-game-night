    "test:rooms": "tsx --env-file=.env scripts/test-rooms.ts",
    "test:lobby": "tsx --env-file=.env scripts/test-lobby.ts",
    "test:game": "tsx --env-file=.env scripts/test-game.ts",
    "test:results": "tsx --env-file=.env scripts/test-results.ts",
    "test:session": "tsx --env-file=.env scripts/test-session.ts",
    "test:history": "tsx --env-file=.env scripts/test-history.ts",
    "test:snowball": "tsx scripts/test-snowball.ts",
    "test:snowball-net": "tsx --env-file=.env scripts/test-snowball-net.ts",
    "test:finish": "tsx --env-file=.env scripts/test-finish.ts",
    "test:network": "tsx --env-file=.env scripts/test-network.ts",
